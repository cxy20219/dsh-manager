{
  "name": "dsh-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Manager panel for the DeepSeek Assistant: one self-contained skill workspace over every agent on this machine (vendored kernel, no extra plugin required), stdio MCP servers, per-channel web search (keyless engines, independent switches and keys, merge/fallback modes, cooldowns and cache), agent modes, and LAN access.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check:vendored": "node scripts/check-vendored.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
